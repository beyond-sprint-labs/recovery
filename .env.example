# ---------------------------------------------------------------------------
# Recovery - environment template. Copy to `.env` (git-ignored) and fill in.
# NEVER commit real secrets. Empty values behave like unset variables.
# ---------------------------------------------------------------------------

# --- runtime modes ----------------------------------------------------------
APP_ENV=local                         # local | test | production (production => fail-fast if PAYPAL_MODE=mock or AGENT_MODE=scripted)
DEMO_MODE=true                        # preset: mock PayPal + scripted agent + SQLite + seed, no API keys needed
PAYPAL_MODE=mock                      # mock | real
AGENT_MODE=scripted                   # scripted | llm
ALLOW_SCENARIO_ID=true                # honour `scenario_id` (S01..S12) even when AGENT_MODE=llm
ALLOW_SANDBOX_PAYMENT_SHORTCUT=false  # enables POST /proposals/{id}/sandbox/record-payment (Sandbox only)
CUSTOMER_TOKEN_TTL_MIN=1440           # lifetime of the one-time customer link, in minutes

# --- infrastructure ---------------------------------------------------------
DATABASE_URL=sqlite:///./recovery.db  # light OCI box: SQLite+WAL; with more memory: postgresql+psycopg://user:pass@host/db
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173    # comma-separated explicit origins; "*" is rejected at startup
UVICORN_WORKERS=1                     # 1 on the 1 GB OCI instance (max 2)

# --- LLM (leave empty with AGENT_MODE=scripted) -----------------------------
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- PayPal Sandbox (Invoicing API v2) --------------------------------------
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_EMAIL=               # Business Sandbox Email (evita 422 USER_NOT_FOUND en invoicer)
PAYPAL_SANDBOX_BUYER_EMAIL=           # optional: route invoices to a real Sandbox buyer account without committing it

# --- merchant policy (server side only; never accepted from a request) ------
POLICY_MAX_DISCOUNT_PCT=15
POLICY_MIN_DOWN_PAYMENT_PCT=20
POLICY_MAX_INSTALLMENTS=6
POLICY_MAX_FINANCING_RATE_PCT=2.0
MERCHANT_DISCOUNT_RATE_PCT=1.0